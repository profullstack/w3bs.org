{
  "name": "w3bs",
  "version": "0.1.0",
  "private": true,
  "description": "W3BS community draft reference stack — the open Web for humans, agents and devices",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "w3bs": "src/cli.mjs",
    "w3bs-open": "native/client.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs",
    "seed:sign": "node scripts/sign-examples.mjs",
    "mcp": "node src/mcp-stdio.mjs",
    "conformance": "node scripts/conformance.mjs",
    "build": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "canonicalize": "2.1.0",
    "express": "5.1.0",
    "marked": "16.4.2",
    "pg": "^8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  }
}
