{
  "name": "w3bs",
  "version": "0.1.0",
  "private": true,
  "description": "W3BS community draft reference stack — the open Web for humans, agents and devices",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "bin": {
    "w3bs-reference": "src/cli.mjs",
    "w3bs-open": "native/client.mjs",
    "w3bs-training": "training/bin/w3bs-training.mjs"
  },
  "scripts": {
    "start": "bun src/server.mjs",
    "dev": "bun --watch src/server.mjs",
    "test": "bun test test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "bun scripts/check.mjs",
    "seed:sign": "bun scripts/sign-examples.mjs",
    "mcp": "bun src/mcp-stdio.mjs",
    "conformance": "bun scripts/conformance.mjs",
    "build": "bun scripts/check.mjs",
    "training": "bun training/bin/w3bs-training.mjs",
    "training:schemas": "bun training/schema/generate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@profullstack/bridges": "0.2.0",
    "@profullstack/hqtui": "0.10.3",
    "@profullstack/stack": "0.4.0",
    "@profullstack/threatcrush": "0.13.30",
    "@simplewebauthn/server": "13.3.3",
    "canonicalize": "2.1.0",
    "express": "5.1.0",
    "marked": "16.4.2",
    "pg": "^8.23.0",
    "ws": "8.21.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  },
  "overrides": {
    "nodemailer": "10.1.0"
  }
}
