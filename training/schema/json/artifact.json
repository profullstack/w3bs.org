{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9_-]{1,64}$"
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.?(\\/|$))[A-Za-z0-9._\\/-]+$"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "video/webm",
        "video/mp4"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "redacted": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "path",
    "media_type",
    "sha256",
    "bytes"
  ],
  "additionalProperties": false,
  "$id": "https://w3bs.org/schemas/training/0.1/artifact.json",
  "title": "W3BS Demonstration Dataset 0.1: artifact"
}
