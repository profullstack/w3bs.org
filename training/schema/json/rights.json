{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "declared_by": {
      "type": "string",
      "maxLength": 200
    },
    "source_rights": {
      "type": "string",
      "enum": [
        "own_capture",
        "licensed",
        "authorized",
        "unknown"
      ]
    },
    "permitted_uses": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "human_review",
          "private_retrieval",
          "external_retrieval",
          "model_training",
          "evaluation",
          "public_distribution"
        ]
      }
    },
    "license": {
      "type": "string",
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "declared_by",
    "source_rights",
    "permitted_uses"
  ],
  "additionalProperties": false,
  "$id": "https://w3bs.org/schemas/training/0.1/rights.json",
  "title": "W3BS Demonstration Dataset 0.1: rights"
}
