{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "w3bs-demonstration-dataset"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^bun_[A-Za-z0-9_-]{1,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "capture_profile": {
      "type": "string",
      "enum": [
        "visual-review",
        "semantic-demonstration",
        "action-supervision"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "episodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "labels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sessions",
        "episodes",
        "observations",
        "actions",
        "labels",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "text_values_included": {
          "type": "boolean"
        },
        "redaction_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "text_values_included",
        "redaction_applied"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "maxLength": 80
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "human_review",
              "private_retrieval",
              "external_retrieval",
              "model_training",
              "evaluation",
              "public_distribution"
            ]
          }
        }
      },
      "required": [
        "dataset_id",
        "version",
        "digest",
        "purposes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "schema_version",
    "bundle_id",
    "created_at",
    "producer",
    "capture_profile",
    "counts",
    "privacy"
  ],
  "additionalProperties": false,
  "$id": "https://w3bs.org/schemas/training/0.1/manifest.json",
  "title": "W3BS Demonstration Dataset 0.1: manifest"
}
