{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9_-]{1,64}$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "episode",
            "step",
            "observation"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "field_path": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
    },
    "value": {},
    "source": {
      "type": "string",
      "enum": [
        "human",
        "device_event",
        "application_event",
        "deterministic_rule",
        "model_inference",
        "imported"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "rejected"
      ]
    },
    "evidence": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "author": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "model",
            "rule",
            "import"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9_-]{1,64}$"
    }
  },
  "required": [
    "schema_version",
    "revision_id",
    "subject",
    "field_path",
    "value",
    "source",
    "status",
    "author",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://w3bs.org/schemas/training/0.1/label_revision.json",
  "title": "W3BS Demonstration Dataset 0.1: label_revision"
}
