#!/bin/sh
# W3BS OS live system: SSH on by default, so a server can be installed from another
# computer (web consoles cannot paste). Root gets a random one-time password, shown on the
# console (tty1) with the ssh command; a preset's keys work too. Live system only: the
# installer removes these settings from the installed system.
[ -e /etc/w3bs-os/live ] || exit 0
repo=
for d in /media/*/apks; do [ -e "$d/x86_64/APKINDEX.tar.gz" ] && repo=$d && break; done
command -v sshd >/dev/null 2>&1 || apk add --no-network ${repo:+--repository "$repo"} openssh-server openssh-server-common-openrc >/dev/null 2>&1 \
	|| { echo "w3bs-live-ssh: cannot install openssh-server" >&2; exit 0; }
pw=$(tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' </dev/urandom 2>/dev/null | head -c 12)
pw="$(echo "$pw" | cut -c1-4)-$(echo "$pw" | cut -c5-8)-$(echo "$pw" | cut -c9-12)"
echo "root:$pw" | chpasswd >/dev/null 2>&1
umask 077
echo "$pw" >/run/w3bs-live-ssh-password
if [ -s /usr/share/w3bs-os/preset/keys/root ]; then
	mkdir -p /root/.ssh && cp /usr/share/w3bs-os/preset/keys/root /root/.ssh/authorized_keys
fi
umask 022
echo 'SSHD_OPTS="-o PermitRootLogin=yes -o PasswordAuthentication=yes"' >/etc/conf.d/sshd
ssh-keygen -A >/dev/null 2>&1
rc-service sshd start >/dev/null 2>&1
