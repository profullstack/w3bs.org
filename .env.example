PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
W3BS_DATA_DIR=.local/data
# Set a random secret of at least 32 characters to enable publishing/revocation.
# Keep this in your deployment secret manager, never in the repository.
W3BS_PUBLISH_TOKEN=
# Optional operator-controlled trust store, defaults to fixtures/trust.json.
# Key entries bind Ed25519 public keys to publisher namespaces.
W3BS_TRUST_FILE=
# Client settings
W3BS_API=http://localhost:3000
